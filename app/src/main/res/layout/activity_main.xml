<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/stat_sys_upload"
            android:contentDescription="dronmxE logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="dronmxE · RC 2 Bridge"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inyector MTP de Misiones a DJI Fly"
                android:textColor="@color/brand_cyan"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Success Banner (Hidden by default) -->
            <LinearLayout
                android:id="@+id/card_success_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#064e3b"
                android:padding="14dp"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎉 ¡MISIÓN INYECTADA CON ÉXITO!"
                    android:textColor="#34d399"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_success_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="1. Abre la pantalla del control DJI RC 2.\n2. En DJI Fly entra a Rutas de Vuelo.\n3. Abre la misión y presiona Iniciar Vuelo."
                    android:textColor="#d1fae5"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Card 1: USB Connection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface_card"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTADO DEL CONTROL REMOTO"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <View
                        android:id="@+id/view_status_dot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@color/brand_amber" />

                    <TextView
                        android:id="@+id/tv_usb_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Buscando control DJI RC 2..."
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_refresh_usb"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Reconectar"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textColor="#000"
                        android:backgroundTint="@color/brand_cyan" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 2: Mission KMZ File -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface_card"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ARCHIVO KMZ A INYECTAR"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_kmz_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 detectados"
                        android:textColor="@color/brand_cyan"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_selected_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Buscando misiones KMZ en el teléfono..."
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_file_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Toca 'Elegir de la lista' o 'Examinar' para seleccionar"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btn_list_kmz"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="📋 Elegir de Lista"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:backgroundTint="#1e293b" />

                    <Button
                        android:id="@+id/btn_pick_file"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="📁 Examinar..."
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:backgroundTint="#1e293b" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: Target Slot -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface_card"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RANURA DESTINO EN DJI FLY"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/et_target_slot"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#0b0f17"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="DF5F9C06-1155-4737-9376-B36B0DD6E9F8"
                        android:textColor="@color/brand_cyan"
                        android:textSize="12sp"
                        android:singleLine="true" />

                    <Button
                        android:id="@+id/btn_scan_slots"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:text="🔍 Ranuras"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:textColor="@color/text_primary"
                        android:backgroundTint="#1e293b" />
                </LinearLayout>
            </LinearLayout>

            <!-- Giant Action Button (1-Click Sync) -->
            <Button
                android:id="@+id/btn_inject_mission"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🚀 SOBREESCRIBIR EN DJI FLY (RC 2)"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#000"
                android:backgroundTint="@color/brand_green"
                android:layout_marginBottom="12dp" />

            <!-- Card 4: Live Console Log -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/console_bg"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REGISTRO DE OPERACIÓN MTP"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_console_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="[INICIO] dronmxE MTP Bridge inicializado."
                    android:textColor="#34d399"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
